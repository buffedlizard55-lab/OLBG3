        <!-- teaser row -->
        <div class="teaser-row-wrapper teaser-row--full">
            <div class="teaser-row-inner">
                <div class="teaser-row">
                    <!-- item -->
                    <div class="teaser-item">
                      <a href="http://shop.eurohandball.com/" target="">
                            <picture>
                              <source media="(min-width: 75rem)" data-srcset="/media/owccno05/hummel_shop.png?rxy=0.50393430659829219,0.24592885449429344&amp;width=1920&amp;height=570&amp;format=webp&amp;quality=80&amp;v=1dcb6ede809c110 1x, /media/owccno05/hummel_shop.png?rxy=0.50393430659829219,0.24592885449429344&amp;width=2880&amp;height=855&amp;format=webp&amp;quality=80&amp;v=1dcb6ede809c110 2x">
