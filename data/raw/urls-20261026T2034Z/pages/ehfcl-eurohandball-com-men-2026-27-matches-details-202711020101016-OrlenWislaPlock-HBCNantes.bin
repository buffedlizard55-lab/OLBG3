                   :alt="transmission.tvStation.name"
                   data-src="/frontend.kw/dist/assets/img/blank.png"
                   v-lazy="'/frontend.kw/dist/assets/img/flags/' + transmission.tvStation.nationAbbreviation + '.svg'"/>
              {{transmission.tvStation.name}}
            </a>
