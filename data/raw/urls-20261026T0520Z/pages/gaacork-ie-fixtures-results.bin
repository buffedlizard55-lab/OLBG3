.gaa-section {
    margin: 35px 0;
}

.gaa-section-title {
    background: #c8102e;
    color: #ffffff;
    padding: 12px 15px;
    margin: 0 0 12px 0;
    border-radius: 4px;
    font-size: 20px;
    font-weight: 700;
}

.gaa-grid {
    width: calc(100% + 20px);
    border-collapse: separate;
    border-spacing: 10px;
    margin: 0 -10px;
}

.gaa-grid td {
    width: 33.33%;
    padding: 0;
    vertical-align: middle;
}

.gaa-grid a {
    display: block;
    padding: 15px 10px;
    background: #f5f5f5;
    border: 1px solid #dddddd;
    border-radius: 5px;
    color: #222222 !important;
    text-decoration: none !important;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    line-height: 1.3;
    min-height: 20px;
}

.gaa-grid a:hover {
    background: #c8102e;
    color: #ffffff !important;
    border-color: #c8102e;
}

@media only screen and (max-width: 600px) {
    .gaa-grid {
        border-spacing: 6px;
        margin: 0 -6px;
        width: calc(100% + 12px);
    }

    .gaa-grid td {
        width: 50%;
    }

    .gaa-grid a {
        font-size: 14px;
        padding: 12px 6px;
    }
}
</style>


