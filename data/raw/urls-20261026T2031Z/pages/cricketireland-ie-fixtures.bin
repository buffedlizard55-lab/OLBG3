<script type="litespeed/javascript">$(document).ready(function(){const $button=$('.floating-btn');const $section=$('.register-section');let isVisible=!0;if(!$button.length||!$section.length){return}
function checkPosition(){const offset=$section.offset();if(!offset){return}
