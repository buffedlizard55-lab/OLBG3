<script id="nv-play-script-js-after">(function () {
  var attempts = 0;
  var maxAttempts = 60;
  var retryDelay = 250;
  var watchdogStarted = false;
  var restoredOnce = false;
  var fallbackStarted = false;
  var config = window.__ciNvplayConfig || {};

  function sourceWidget() {
    return document.querySelector('nvplay');
  }

  function host() {
    return document.querySelector('.nvplay-banner');
  }

  function wrapper() {
    return document.querySelector('.nvplay-banner .nvp-widget-wrapper, .nvplay-banner .nvp-widget-match-strip, .nvp-widget-wrapper, .nvp-widget-match-strip');
  }

  function stripHasContent() {
    var strip = document.querySelector('.nvp-match-strip');
    return !!(strip && strip.textContent && strip.textContent.trim().length > 0);
  }

  function markReady() {
    if (document.body) document.body.classList.add('nvp-widget-active');
  }

  function parseWidgets() {
    if (window.$jqNvPlay && typeof window.$jqNvPlay.$parseWidgets === 'function') {
      window.$jqNvPlay.$parseWidgets();
      return true;
    }
    return false;
  }

  function retry() {
    if (attempts < maxAttempts) {
      attempts += 1;
      window.setTimeout(initNVPlay, retryDelay);
    } else {
      console.warn('NV Play library did not become ready before timeout');
      renderFallback();
    }
  }

  function restoreSourceWidget() {
    var target = host();
    if (!target || !config.sourceHtml) return false;
    target.innerHTML = config.sourceHtml;
    return true;
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value).replace(/[&<>'"]/g, function (char) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char];
    });
  }

  function formatFixture(match) {
    var bits = [];
    if (match.VenueName) bits.push(match.VenueName);
    if (match.StartDateTime) {
      var date = new Date(match.StartDateTime);
      if (!isNaN(date.getTime())) bits.push(date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }));
    }
    return bits.join(' - ');
  }

  function renderFallbackItems(data) {
    var matches = []
      .concat(data && data.Results ? data.Results : [])
      .concat(data && data.Live ? data.Live : [])
      .concat(data && data.Fixtures ? data.Fixtures : []);

    matches = matches.filter(function (match) {
      return match && (match.IsComplete || match.IsLive || match.IsFixture);
    }).slice(0, 20);

    if (!matches.length) return false;

    matches.sort(function (a, b) {
      return new Date(a.StartDateTime).getTime() - new Date(b.StartDateTime).getTime();
    });

    var items = matches.map(function (match) {
      var status = match.MatchStatus || (match.IsComplete ? 'MATCH COMPLETE' : (match.IsLive ? 'LIVE' : 'FIXTURE'));
      var detail = match.IsComplete ? match.Result : (match.IsLive ? ((match.IsTeam1Batting ? match.Team1Name + ' ' + match.Team1Scores : '') || (match.IsTeam2Batting ? match.Team2Name + ' ' + match.Team2Scores : '')) : formatFixture(match));
      var href = config.matchUrlPrefix + encodeURIComponent(match.MatchId || '');
      return '<li class="nvp-match-strip__item' + (match.IsLive ? ' nvp-match--is-live' : '') + (match.IsFixture ? ' nvp-match--fixture' : '') + '">' +
        '<a class="nvp-match-strip__item-block" href="' + escapeHtml(href) + '">' +
          '<span class="nvp-match-strip__item-block-status">' + escapeHtml(status) + '</span>' +
          '<span class="nvp-match-strip__item-block-content">' +
            '<span class="nvp-match-strip__item-teams"><span class="nvp-match-strip__inline-teams-name">' + escapeHtml(match.Team1Name || '') + ' v ' + escapeHtml(match.Team2Name || '') + '</span></span>' +
            '<span class="nvp-match-strip__item-result">' + escapeHtml(detail || '') + '</span>' +
          '</span>' +
        '</a>' +
      '</li>';
    }).join('');

    var target = host();
    if (!target) return false;
    target.innerHTML = '<div id="nvp-widget-fallback" class="nvp-widget-wrapper nvp-widget-match-strip ci-nvplay-fallback"><div class="nvp-match-strip nvp-theme--match-strip"><ul class="nvp-match-strip__list">' + items + '</ul></div></div>';
    markReady();
    return true;
  }

  function renderFallback() {
    if (fallbackStarted || stripHasContent() || !config.feedUrl || !window.fetch) return;
    fallbackStarted = true;
    fetch(config.feedUrl, { mode: 'cors', credentials: 'omit', cache: 'no-store' })
      .then(function (response) { return response.ok ? response.json() : Promise.reject(response); })
      .then(renderFallbackItems)
      .catch(function (error) { console.warn('NV Play fallback feed failed', error); });
  }

  function startWatchdog() {
    if (watchdogStarted) return;
    watchdogStarted = true;

    window.setTimeout(function () {
      if (stripHasContent()) {
        markReady();
        return;
      }

      if (!restoredOnce && restoreSourceWidget()) {
        restoredOnce = true;
        attempts = 0;
        initNVPlay();
      }
    }, 5000);

    window.setTimeout(function () {
      if (!stripHasContent()) renderFallback();
    }, 9000);
  }

  function initNVPlay() {
    if (stripHasContent()) {
      markReady();
      return;
    }

    if (!window.$jqNvPlay || typeof window.$jqNvPlay.$parseWidgets !== 'function') {
      retry();
      return;
    }

    if (sourceWidget()) {
      parseWidgets();
      startWatchdog();
      return;
    }

    if (wrapper()) {
      startWatchdog();
      return;
    }

    retry();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNVPlay, { once: true });
  } else {
    initNVPlay();
  }
}());
//# sourceURL=nv-play-script-js-after</script>
