<script>

function calcolaDifferenzaDate(data1, data2) {
    
    function stringaAData(dataStringa) {
        const [giorno, mese, annoOra] = dataStringa.split("/");
        const [anno, ora] = annoOra.split(" ");
        return new Date(`${anno}-${mese}-${giorno}T${ora}`);
    }

    const d1 = stringaAData(data1);
    const d2 = stringaAData(data2);

    let differenzaMs = Math.abs(d2 - d1);

    const differenzaSec = Math.floor(differenzaMs / 1000);
    const differenzaMin = Math.floor(differenzaSec / 60);
    const differenzaOre = Math.floor(differenzaMin / 60);

    return {
        ore: differenzaOre,
        minuti: differenzaMin % 60,
        secondi: differenzaSec % 60
    };
}


const data1 = "26/10/2026 21:31:08";
const data2 = getDataOraDisplay();

const differenza = calcolaDifferenzaDate(data1, data2);


console.log("Ora della versione in cache: "+data1);
console.log("Ora attuale:                 "+data2);
console.log("Vecchiaia versione cache:");
console.log(differenza);


</script>
