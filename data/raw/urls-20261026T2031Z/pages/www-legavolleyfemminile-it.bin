                                            var contenitoreNewsPrimoPianoVisibile = true;
                                            
                                            $(function(){


                                                const contenitoreNewsPrimoPiano = document.querySelector('.contenitore-news-primo-piano-home');

                                                if (contenitoreNewsPrimoPiano) {

                                                  const observer = new IntersectionObserver((entries, observer) => {
                                                    entries.forEach(entry => {
                                                      if (entry.isIntersecting) {
                                                          contenitoreNewsPrimoPianoVisibile = true;
                                                      }else{
                                                          contenitoreNewsPrimoPianoVisibile = false;
                                                      }
                                                      
                                                    });
                                                  }, {
                                                    threshold: 0.1 // Attiva l'osservazione quando il 10% dell'elemento è visibile
                                                  });

                                                  // Inizia a osservare l'elemento
                                                  observer.observe(contenitoreNewsPrimoPiano);
                                                }



                                                
                                                initSwipeTouchMobile(function(){
                                                    
                                                    if(contenitoreNewsPrimoPianoVisibile)
