<style>
:root{--theme-background-primary:#081A1F;--theme-background-secondary:#0D252A;--theme-surface:#132F35;--theme-surface-elevated:#1B3940;--theme-card:#112A30;--theme-accent-primary:#2DD4BF;--theme-accent-secondary:#0F766E;--theme-accent-deep:#115E59;--theme-accent-subtle:#174046;--theme-accent-hover:#5EEAD4;--theme-accent-text:#062C2B;--theme-text-primary:#F0FDFA;--theme-text-secondary:#C7DDDA;--theme-text-muted:#A8C5C1;--theme-border:#355B61;--theme-link:#5EEAD4;--theme-button-primary:#2DD4BF;--theme-button-secondary:#134E4A;--theme-hover:#23474B;--theme-active:#0F766E;--theme-focus:#5EEAD4;--theme-disabled:#294348;--theme-success:#52DEA9;--theme-warning:#F0C36A;--theme-error:#FF8992;--theme-error-surface:#873444;--theme-text-disabled:#86A5A6;--theme-info:#78CFE3;--theme-shadow:rgba(2,12,17,.38);--theme-glow:rgba(45,212,191,.16);--theme-overlay:rgba(3,16,20,.74);--theme-gradient-start:#0C242A;--theme-gradient-end:#164048;--landing-yellow:var(--theme-accent-primary);--landing-yellow-hover:var(--theme-accent-hover);--landing-yellow-soft:var(--theme-accent-subtle);--landing-yellow-ink:var(--theme-accent-hover);--landing-ink:var(--theme-text-primary);}
[data-testid="BuyNowButton"]{background:var(--theme-button-primary) !important;border-color:var(--theme-accent-primary) !important;color:var(--theme-accent-text)!important;}
[data-testid="BuyNowButton"]:hover, [data-testid="BuyNowButton"]:focus-visible{background:var(--theme-accent-hover)!important;border-color:var(--theme-focus) !important;}
.landing-social-proof{background:var(--theme-surface);border-top:1px solid var(--theme-border);color:var(--theme-text-primary);padding:64px 24px 72px;}
.landing-social-proof__inner{margin:0 auto;max-width:1180px;}
.landing-section-kicker{color:var(--theme-accent-hover);font-size:12px;font-weight:800;letter-spacing:.14em;margin:0 0 10px;text-transform:uppercase;}
.landing-section-title{color:var(--theme-text-primary);font-size:clamp(28px,4vw,44px);letter-spacing:-.035em;line-height:1.08;margin:0;}
.wkwkland-review-marquee{overflow:hidden;padding-bottom:30px;width:100%;}
.wkwkland-review-marquee__heading{align-items:flex-end;border-bottom:2px solid var(--theme-border);display:flex;gap:18px;justify-content:space-between;margin-bottom:22px;padding-bottom:12px;}
.wkwkland-review-marquee__heading > span{color:var(--theme-text-secondary);flex:0 0 auto;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;}
.wkwkland-review-marquee__viewport{overflow:hidden;padding:0 6px 7px 0;width:100%;}
.wkwkland-review-marquee__track{animation:wkwkland-review-marquee 36s linear infinite;display:flex;width:max-content;will-change:transform;}
.wkwkland-review-marquee__set{display:flex;gap:18px;padding-right:18px;}
.wkwkland-review-marquee__card{background:var(--theme-surface);border:1px solid var(--theme-border);border-radius:0;box-shadow:5px 5px 0 var(--theme-glow);box-sizing:border-box;min-height:184px;padding:20px;width:330px;}
.wkwkland-review-marquee__meta{align-items:center;border-bottom:1px solid var(--theme-border);display:flex;gap:12px;justify-content:space-between;margin-bottom:18px;padding-bottom:11px;}
.wkwkland-review-marquee__name{font-weight:900;letter-spacing:.02em;}
.wkwkland-review-marquee__stars{color:var(--theme-accent-hover);letter-spacing:.06em;}
.wkwkland-review-marquee__card p{color:var(--theme-text-primary);font-size:13px;line-height:1.55;margin:0;}
.wkwkland-review-marquee__viewport:hover .wkwkland-review-marquee__track{animation-play-state:paused;}
@keyframes wkwkland-review-marquee{
from{transform:translateX(0);}
to{transform:translateX(-50%);}
}
.landing-faq{margin-top:68px;}
.landing-faq-list{border-top:1px solid var(--theme-border);margin-top:28px;}
.landing-faq details{border-bottom:1px solid var(--theme-border);}
.landing-faq summary{align-items:center;cursor:pointer;display:flex;font-size:18px;font-weight:800;gap:16px;justify-content:space-between;list-style:none;padding:22px 2px;}
.landing-faq summary::-webkit-details-marker{display:none;}
.landing-faq summary::after{align-items:center;background:var(--theme-button-primary);border-radius:50%;color:var(--theme-accent-text);content:"+";display:inline-flex;flex:0 0 30px;font-size:21px;height:30px;justify-content:center;transition:transform .2s ease;width:30px;}
.landing-faq details[open] summary::after{transform:rotate(45deg);}
.landing-faq details p{color:var(--theme-text-primary);line-height:1.65;margin:-4px 48px 22px 2px;max-width:760px;}
@media (max-width: 767px){
.wkwkland-review-marquee__heading{align-items:flex-start;flex-direction:column;}
.wkwkland-review-marquee__card{width:280px;}
body{padding-bottom:calc(64px + env(safe-area-inset-bottom)) !important;}
[data-testid="BuyNowButton"]{border:0 !important;border-radius:0 !important;bottom:0 !important;box-shadow:0 -8px 28px rgba(2,12,17,.18) !important;font-size:17px !important;font-weight:900 !important;height:calc(60px + env(safe-area-inset-bottom)) !important;left:0 !important;margin:0 !important;max-width:none !important;padding:0 20px env(safe-area-inset-bottom) !important;position:fixed !important;right:0 !important;top:auto !important;width:100vw !important;z-index:2147483000 !important;}
.landing-social-proof{padding:48px 16px 56px;}
.landing-review-summary{align-items:flex-start;flex-direction:column;}
.landing-review-grid{grid-template-columns:1fr;}
.landing-review-card{min-height:0;padding:20px;}
.landing-faq{margin-top:52px;}
.landing-faq summary{font-size:16px;padding:19px 0;}
.landing-faq details p{margin:-2px 42px 20px 0;}
}
</style>

<style id="Modal50-reference-content-style">
#Modal50-warranty-generator{--wkwkland-yellow:var(--theme-accent-primary);--wkwkland-black:var(--theme-background-primary);--wkwkland-paper:var(--theme-surface-elevated);--wkwkland-line:var(--theme-border);background:var(--theme-surface);border:2px solid var(--theme-border);box-shadow:7px 7px 0 var(--theme-glow);box-sizing:border-box;font-family:inherit;margin:24px 7px 7px 0;max-width:100%;min-width:0;padding:0;position:relative;width:calc(100% - 7px);}
#Modal50-warranty-generator, #Modal50-warranty-generator *{box-sizing:border-box;}
#Modal50-warranty-generator .wkwkland-number-lab__head{align-items:center;background:var(--theme-background-secondary);color:var(--theme-text-primary);display:flex;gap:16px;justify-content:space-between;padding:14px 16px;}
#Modal50-warranty-generator .wkwkland-number-lab__head strong{color:var(--theme-link);font-family:inherit;font-size:13px;font-weight:800;letter-spacing:.08em;line-height:1.4;}
#Modal50-warranty-generator .wkwkland-number-lab__head button{background:var(--theme-button-primary);border:1px solid var(--theme-accent-primary);border-radius:0;color:var(--theme-accent-text);cursor:pointer;font-family:inherit;font-size:10px;font-weight:900;letter-spacing:.05em;min-height:32px;padding:0 12px;text-transform:uppercase;}
#Modal50-warranty-generator .wkwkland-generate-numbers:focus-visible{outline:2px solid var(--theme-focus);outline-offset:3px;}
#Modal50-warranty-generator .wkwkland-number-table-wrap{overflow-x:auto;}
#Modal50-warranty-generator .wkwkland-number-table{background:var(--theme-surface);border-collapse:collapse;font-size:12px;margin:0;table-layout:fixed;width:100%;}
#Modal50-warranty-generator .wkwkland-number-table th, #Modal50-warranty-generator .wkwkland-number-table td{border-bottom:1px solid var(--theme-border);padding:13px 14px;text-align:left;vertical-align:top;}
#Modal50-warranty-generator .wkwkland-number-table th{background:var(--theme-surface-elevated);color:var(--theme-text-primary);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;width:78px;}
#Modal50-warranty-generator .wkwkland-number-cell{display:flex;flex-wrap:wrap;gap:6px;}
#Modal50-warranty-generator .wkwkland-number-chip{align-items:center;background:var(--theme-background-secondary);color:var(--theme-link);display:inline-flex;font-family:Consolas,"Courier New",monospace;font-size:13px;font-weight:800;justify-content:center;letter-spacing:.12em;line-height:1.3;min-width:56px;padding:6px 8px;}
#Modal50-warranty-generator .wkwkland-number-note{color:var(--theme-text-secondary);font-size:10px;line-height:1.45;margin:0;padding:10px 14px;}
#Modal50-warranty-generator .Modal50-generator-status{clip-path:inset(50%);height:1px;overflow:hidden;padding:0;position:absolute;white-space:nowrap;width:1px;}
@media (max-width: 380px){
#Modal50-warranty-generator .wkwkland-number-lab__head{gap:8px;padding:12px;}
#Modal50-warranty-generator .wkwkland-number-table th{width:60px;}
#Modal50-warranty-generator .wkwkland-number-table th, #Modal50-warranty-generator .wkwkland-number-table td{padding:12px 10px;}
}
</style>

<style id="Modal50-review-motion-accessibility">
@media (prefers-reduced-motion: reduce){
.wkwkland-review-marquee__viewport{overflow-x:auto;}
.wkwkland-review-marquee__track{animation:none;}
}
</style>

