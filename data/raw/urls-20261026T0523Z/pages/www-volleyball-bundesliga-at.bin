10%{-webkit-transform:rotate(135deg);transform:rotate(135deg);}
25%{-webkit-transform:rotate(245deg);transform:rotate(245deg);}
60%{-webkit-transform:rotate(700deg);transform:rotate(700deg);}
75%{-webkit-transform:rotate(810deg);transform:rotate(810deg);}
