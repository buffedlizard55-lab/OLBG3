0%{-webkit-transform:rotate(0deg);transform:rotate(0deg);}
10%{-webkit-transform:rotate(135deg);transform:rotate(135deg);}
25%{-webkit-transform:rotate(245deg);transform:rotate(245deg);}
60%{-webkit-transform:rotate(700deg);transform:rotate(700deg);}
75%{-webkit-transform:rotate(810deg);transform:rotate(810deg);}
to{-webkit-transform:rotate(3turn);transform:rotate(3turn);}
}
@-webkit-keyframes overlay-spin{
0%{opacity:1;-webkit-transform:rotate(45deg);transform:rotate(45deg);}
to{opacity:1;-webkit-transform:rotate(225deg);transform:rotate(225deg);}
}
@keyframes overlay-spin{
0%{opacity:1;-webkit-transform:rotate(45deg);transform:rotate(45deg);}
to{opacity:1;-webkit-transform:rotate(225deg);transform:rotate(225deg);}
}
.rc-anchor{border-radius:3px;box-shadow:0 0 4px 1px rgba(2,12,17,.08);-webkit-box-shadow:0 0 4px 1px rgba(2,12,17,.08);-moz-box-shadow:0 0 4px 1px rgba(2,12,17,.08);}
.rc-anchor-light{background:var(--theme-surface);color:var(--theme-text-primary);}
.rc-anchor-error-msg-container{color:var(--theme-error);font-family:Roboto,helvetica,arial,sans-serif;font-size:12px;font-weight:400;left:0;line-height:14px;margin:2px;position:absolute;top:0;}
.rc-anchor-normal-footer{display:inline-block;height:74px;vertical-align:top;width:70px;}
.rc-anchor-logo-img{background:url(data:image/png;base64,);background-repeat:no-repeat;}
.rc-anchor-light div a:link,.rc-anchor-light div a:visited{color:var(--theme-text-primary);}
.rc-anchor-dark div a:link,.rc-anchor-dark div a:visited{color:var(--theme-text-primary);}
.rc-anchor-invisible .rc-anchor-pt{font-family:Roboto,helvetica,arial,sans-serif;font-size:8px;font-weight:400;}
.rc-anchor-pt{background-image:url(data:image/png;base64,);}
.rc-anchor-pt a:hover{text-decoration:underline;}
#rc-anchor-alert,.rc-anchor-alert{color:var(--theme-error);font-size:9px;margin:2px;position:absolute;top:0;}
.rc-anchor-invisible{height:60px;width:256px;display:flex;}
.rc-anchor-invisible-text{background:var(--theme-accent-primary);color:var(--theme-text-primary);display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-webkit-flex-direction:column;flex-direction:column;-webkit-box-flex:1;-webkit-flex-grow:1;flex-grow:1;font-family:Roboto,helvetica,arial,sans-serif;font-size:13px;font-weight:400;height:100%;-webkit-box-pack:center;-webkit-justify-content:center;justify-content:center;line-height:20px;padding:0 16px;white-space:nowrap;}
.rc-anchor-invisible-text.smalltext .rc-anchor-pt a:link{font-size:9px;}
.rc-anchor-invisible-text strong{font-weight:500;}
.rc-anchor-invisible .rc-anchor-normal-footer .rc-anchor-pt{-webkit-transition:opacity .3s ease;transition:opacity .3s ease;text-align:center;width:70px;margin-top:2px;}
.rc-anchor-logo-img-large{-webkit-transition:all .3s ease;transition:all .3s ease;-webkit-background-size:44px 44px;background-size:44px;margin:8px 13px 0 13px;height:44px;width:44px;}
.rc-anchor-invisible-text .rc-anchor-pt{-webkit-transition:opacity .3s ease;transition:opacity .3s ease;}
.rc-anchor-invisible-text .rc-anchor-pt a:link,.rc-anchor-invisible-text .rc-anchor-pt a:visited{color:var(--theme-text-primary);font-size:10px;}
.rc-anchor-invisible-hover .rc-anchor-invisible-text .rc-anchor-pt a:link{display:none;}
.rc-anchor-invisible-hover-hovered .rc-anchor-invisible-text .rc-anchor-pt a:link,.rc-anchor-invisible-nohover .rc-anchor-invisible-text .rc-anchor-pt a:link{display:inline;}
.rc-anchor-invisible-hover .rc-anchor-normal-footer .rc-anchor-pt a:link{display:inline;}
.rc-anchor-invisible-hover-hovered .rc-anchor-normal-footer .rc-anchor-pt a:link,.rc-anchor-invisible-nohover .rc-anchor-normal-footer .rc-anchor-pt a:link{display:none;}
