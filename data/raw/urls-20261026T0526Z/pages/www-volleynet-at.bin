tion\",\"sport\":null,\"page\":null,\"articleCategory\":null,\"navigation\":[],\"navigationPath\":[\"19\"]}]}]\n"])</script><script>self.__next_f.push([1,"4:[\"$\",\"div\",null,{\"className\":\"flex flex-grow flex-col items-center\",\"children\":[[\"$\",\"$L26\",null,{\"ISR_articles\":[{\"id\":1844,\"author\":\"SL\",\"title\":\"AVL Women: Erzbergmadln weiter in der Erfolgsspur, Sokol/Post müht sich zum Sieg, Men: Aich/Dob weiter schwungvoll, Hartberg schreibt an\",\"perex\":\"Zu einer Revanche für das vergangene Wochenende kam es in Zirl, wo die SU Inzingvolley / VC Mils und die UNIONvolleys Bisamberg-Hollabrunn neuerlich aufeinandertrafen. \",\"image\":\"65cacdf0-93ab-40d3-b9cd-bb5e6cae9452\",\"imageEntity\":{\"id\":\"9a234eab-7667-49cd-b8a4-9352725a9949\",\"url\":\"https://cdn.volley.eliterro.at/9a234eab-7667-49cd-b8a4-9352725a9949.webp\",\"title\":\"Gepa 20261024 101 167 0066\",\"description\":null,\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"thumbnailEntity\":{\"id\":\"65cacdf0-93ab-40d3-b9cd-bb5e6cae9452\",\"url\":\"https://cdn.volley.eliterro.at/65cacdf0-93ab-40d3-b9cd-bb5e6cae9452.webp\",\"title\":\"Gepa 20261024 101 167 0066\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"9a234eab-7667-49cd-b8a4-9352725a9949\",\"url\":\"https://cdn.volley.eliterro.at/9a234eab-7667-49cd-b8a4-9352725a9949.webp\",\"title\":\"Gepa 20261024 101 167 0066\",\"description\":null,\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"preview\":{\"id\":\"65cacdf0-93ab-40d3-b9cd-bb5e6cae9452\",\"url\":\"https://cdn.volley.eliterro.at/65cacdf0-93ab-40d3-b9cd-bb5e6cae9452.webp\",\"title\":\"Gepa 20261024 101 167 0066\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"b3576675-56dc-44ba-b9fa-d5824a531141\",\"url\":\"https://cdn.volley.eliterro.at/b3576675-56dc-44ba-b9fa-d5824a531141.JPG\",\"title\":\"Gepa 20261024 101 167 0066\",\"description\":null,\"type\":\"image/webp\",\"width\":3240,\"height\":2160}},\"activeFrom\":\"2026-10-24T16:33:20Z\",\"activeTo\":null,\"viewsCount\":452,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1843,\"author\":\"Sportlive\",\"title\":\"AVL Women: Klagenfurt auch für Linz zu stark\",\"perex\":\"Die 4. Runde in der Austrian Volley League Women begann mit einer faustdicken Überraschung. Die ATSC Kelag Wildcats Klagenfurt fuhren gegen die LINZ AG Steelvolleys neuerlich ihre Krallen aus und gewannen mit 3:0. \\n\",\"image\":\"ac8a1422-920d-4622-8b90-bb5587834bf8\",\"imageEntity\":{\"id\":\"ace8a267-08aa-4a68-b7ca-532c1b4789c0\",\"url\":\"https://cdn.volley.eliterro.at/ace8a267-08aa-4a68-b7ca-532c1b4789c0.webp\",\"title\":\"Gepa 20261023 101 147 0027\",\"description\":\"GEPA pictures/ Matthias Trinkl\",\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"thumbnailEntity\":{\"id\":\"ac8a1422-920d-4622-8b90-bb5587834bf8\",\"url\":\"https://cdn.volley.eliterro.at/ac8a1422-920d-4622-8b90-bb5587834bf8.webp\",\"title\":\"Gepa 20261023 101 147 0027\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"ace8a267-08aa-4a68-b7ca-532c1b4789c0\",\"url\":\"https://cdn.volley.eliterro.at/ace8a267-08aa-4a68-b7ca-532c1b4789c0.webp\",\"title\":\"Gepa 20261023 101 147 0027\",\"description\":\"GEPA pictures/ Matthias Trinkl\",\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"preview\":{\"id\":\"ac8a1422-920d-4622-8b90-bb5587834bf8\",\"url\":\"https://cdn.volley.eliterro.at/ac8a1422-920d-4622-8b90-bb5587834bf8.webp\",\"title\":\"Gepa 20261023 101 147 0027\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"2ff51cdb-e288-47cf-8017-9e9fe0bfb93e\",\"url\":\"https://cdn.volley.eliterro.at/2ff51cdb-e288-47cf-8017-9e9fe0bfb93e.jpg\",\"title\":\"Gepa 20261023 101 147 0027\",\"description\":\"GEPA pictures/ Matthias Trinkl\",\"type\":\"image/webp\",\"width\":3240,\"height\":2160}},\"activeFrom\":\"2026-10-23T20:01:57Z\",\"activeTo\":null,\"viewsCount\":384,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1842,\"author\":\"ÖVV\",\"title\":\"U20-ÖMS beginnen am Sonntag mit neuem Format\",\"perex\":\"Am Sonntag, 25.10.26, starten die U20 Österreichischen Nachwuchsmeisterschaften (ÖMS) für Mädchen und Burschen mit einem neuen Format. Die Meisterschaften auf dem Großfeld werden ab dieser Saison in drei Runden ausgetragen.\",\"image\":null,\"imageEntity\":null,\"thumbnailEntity\":null,\"media\":null,\"activeFrom\":\"2026-10-23T13:18:56Z\",\"activeTo\":null,\"viewsCount\":500,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1840,\"author\":\"Sportlive\",\"title\":\"AVL: Städteduelle in Wien und Graz, Doppelrunde bei den Männern\",\"perex\":\"Zwei Hartberger Delegationen legen am Wiener Handelskai an, jene aus St. Pölten reisen in den Grazer Raiffeisen Sportpark. Die Herren stehen nach dem Wochenende am Nationalfeiertag gleich noch einmal am Court.\",\"image\":\"608c18c2-3b6d-404b-9ad7-e2cf010fcfbe\",\"imageEntity\":{\"id\":\"edb2f108-d9b0-4eb7-9b8b-9fceb1cf1f83\",\"url\":\"https://cdn.volley.eliterro.at/edb2f108-d9b0-4eb7-9b8b-9fceb1cf1f83.webp\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":\"GEPA pictures/ Matthias Trinkl\",\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"thumbnailEntity\":{\"id\":\"608c18c2-3b6d-404b-9ad7-e2cf010fcfbe\",\"url\":\"https://cdn.volley.eliterro.at/608c18c2-3b6d-404b-9ad7-e2cf010fcfbe.webp\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"edb2f108-d9b0-4eb7-9b8b-9fceb1cf1f83\",\"url\":\"https://cdn.volley.eliterro.at/edb2f108-d9b0-4eb7-9b8b-9fceb1cf1f83.webp\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":\"GEPA pictures/ Matthias Trinkl\",\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"preview\":{\"id\":\"608c18c2-3b6d-404b-9ad7-e2cf010fcfbe\",\"url\":\"https://cdn.volley.eliterro.at/608c18c2-3b6d-404b-9ad7-e2cf010fcfbe.webp\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"10a86297-008e-47a9-aa8e-29eb42d4ed8a\",\"url\":\"https://cdn.volley.eliterro.at/10a86297-008e-47a9-aa8e-29eb42d4ed8a.jpg\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":\"GEPA pictures/ Matthias Trinkl\",\"type\":\"image/webp\",\"width\":3240,\"height\":2160}},\"activeFrom\":\"2026-10-22T11:39:55Z\",\"activeTo\":null,\"viewsCount\":214,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1837,\"author\":\"SL\",\"title\":\"Gelungener AVL-Auftakt für Aich/Dob – Meister Hartberg unterliegt klar\",\"perex\":\"Der SK Zadruga Aich/Dob ist mit einem souveränen Auswärtssieg in die Austrian Volley League Men gestartet. Die Kärntner setzten sich beim amtierenden Meister und frischgebackenen Supercupsieger TSV Raiffeisen Hartberg glatt mit 3:0 (25:20, 25:23, 25:17) durch, feierten damit einen gelungenen Saisonauftakt. Für die Steirer verlief der Start in die neue Spielzeit hingegen enttäuschend.\",\"image\":\"85e18de7-5b1d-404c-b96c-def4e27664a4\",\"imageEntity\":{\"id\":\"0b002dd6-ff2b-48f8-9248-9ad3093e0a71\",\"url\":\"https://cdn.volley.eliterro.at/0b002dd6-ff2b-48f8-9248-9ad3093e0a71.webp\",\"title\":\"Gepa 20261020 101 157 0234\",\"description\":null,\"type\":\"image/webp\",\"width\":1619,\"height\":1080},\"thumbnailEntity\":{\"id\":\"85e18de7-5b1d-404c-b96c-def4e27664a4\",\"url\":\"https://cdn.volley.eliterro.at/85e18de7-5b1d-404c-b96c-def4e27664a4.webp\",\"title\":\"Gepa 20261020 101 157 0234\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"0b002dd6-ff2b-48f8-9248-9ad3093e0a71\",\"url\":\"https://cdn.volley.eliterro.at/0b002dd6-ff2b-48f8-9248-9ad3093e0a71.webp\",\"title\":\"Gepa 20261020 101 157 0234\",\"description\":null,\"type\":\"image/webp\",\"width\":1619,\"height\":1080},\"preview\":{\"id\":\"85e18de7-5b1d-404c-b96c-def4e27664a4\",\"url\":\"https://cdn.volley.eliterro.at/85e18de7-5b1d-404c-b96c-def4e27664a4.webp\",\"title\":\"Gepa 20261020 101 157 0234\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"6f0f5578-c131-41cd-8f42-6a2b10d5faac\",\"url\":\"https://cdn.volley.eliterro.at/6f0f5578-c131-41cd-8f42-6a2b10d5faac.JPG\",\"title\":\"Gepa 20261020 101 157 0234\",\"description\":null,\"type\":\"image/webp\",\"width\":3111,\"height\":2075}},\"activeFrom\":\"2026-10-20T20:33:19Z\",\"activeTo\":null,\"viewsCount\":362,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1836,\"author\":\"SL\",\"title\":\"AVL: Erzbergmadln bleiben ungeschlagen und gewinnen auch das zweite Steirer-Derby\",\"perex\":\"Die ZPP Erzbergmadln Trofaiach Eisenerz bleiben in der Austrian Volley League Women weiter ohne Niederlage! Nur wenige Tage nach dem Sieg über UVC Holding Graz legte der Tabellenführer im ORF-Live-Spiel am Dienstag nach und gewann auch das zweite Steirer-Derby.\",\"image\":\"f2719611-6951-4087-a20e-8851ea05f66c\",\"imageEntity\":{\"id\":\"69fec946-df0d-4189-874b-ed91b5c5258f\",\"url\":\"https://cdn.volley.eliterro.at/69fec946-df0d-4189-874b-ed91b5c5258f.webp\",\"title\":\"Gepa 20261020 101 157 0182\",\"description\":null,\"type\":\"image/webp\",\"width\":1621,\"height\":1080},\"thumbnailEntity\":{\"id\":\"f2719611-6951-4087-a20e-8851ea05f66c\",\"url\":\"https://cdn.volley.eliterro.at/f2719611-6951-4087-a20e-8851ea05f66c.webp\",\"title\":\"Gepa 20261020 101 157 0182\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"69fec946-df0d-4189-874b-ed91b5c5258f\",\"url\":\"https://cdn.volley.eliterro.at/69fec946-df0d-4189-874b-ed91b5c5258f.webp\",\"title\":\"Gepa 20261020 101 157 0182\",\"description\":null,\"type\":\"image/webp\",\"width\":1621,\"height\":1080},\"preview\":{\"id\":\"f2719611-6951-4087-a20e-8851ea05f66c\",\"url\":\"https://cdn.volley.eliterro.at/f2719611-6951-4087-a20e-8851ea05f66c.webp\",\"title\":\"Gepa 20261020 101 157 0182\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"eb1d3108-98d0-42d6-874a-711eb5b6899b\",\"url\":\"https://cdn.volley.eliterro.at/eb1d3108-98d0-42d6-874a-711eb5b6899b.JPG\",\"title\":\"Gepa 20261020 101 157 0182\",\"description\":null,\"type\":\"image/webp\",\"width\":3207,\"height\":2137}},\"activeFrom\":\"2026-10-20T18:11:29Z\",\"activeTo\":null,\"viewsCount\":218,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1835,\"author\":\"Florian Stangl\",\"title\":\"ÖVV-Volleystars im Ausland: Viel Routine und frisches Blut\",\"perex\":\"In dieser Woche widmet sich der Blog zwei ÖVV-Routiniers und zwei Teamspielern, die in dieser Saison erstmals im Ausland spielen. Alex Berger und Peter Wohlfahrtstätter bringen es zusammen auf mehr als 25 Jahre Auslandserfahrung. Paul Nusterer und Sebastian Sablatnig haben heuer sportliches Neuland betreten.\",\"image\":\"be74d8ae-677b-4c47-b10e-00743c6776a9\",\"imageEntity\":{\"id\":\"0de68214-082e-467c-9a37-4a23fd253084\",\"url\":\"https://cdn.volley.eliterro.at/0de68214-082e-467c-9a37-4a23fd253084.webp\",\"title\":\"Whats App Image 2026 10 21 at 09.08.28\",\"description\":null,\"type\":\"image/webp\",\"width\":864,\"height\":1080},\"thumbnailEntity\":{\"id\":\"be74d8ae-677b-4c47-b10e-00743c6776a9\",\"url\":\"https://cdn.volley.eliterro.at/be74d8ae-677b-4c47-b10e-00743c6776a9.webp\",\"title\":\"Whats App Image 2026 10 21 at 09.08.28\",\"description\":null,\"type\":\"image/webp\",\"width\":384,\"height\":480},\"media\":{\"full\":{\"id\":\"0de68214-082e-467c-9a37-4a23fd253084\",\"url\":\"https://cdn.volley.eliterro.at/0de68214-082e-467c-9a37-4a23fd253084.webp\",\"title\":\"Whats App Image 2026 10 21 at 09.08.28\",\"description\":null,\"type\":\"image/webp\",\"width\":864,\"height\":1080},\"preview\":{\"id\":\"be74d8ae-677b-4c47-b10e-00743c6776a9\",\"url\":\"https://cdn.volley.eliterro.at/be74d8ae-677b-4c47-b10e-00743c6776a9.webp\",\"title\":\"Whats App Image 2026 10 21 at 09.08.28\",\"description\":null,\"type\":\"image/webp\",\"width\":384,\"height\":480},\"original\":{\"id\":\"4141242e-1e1d-4c24-a2b3-dc1efbd18247\",\"url\":\"https://cdn.volley.eliterro.at/4141242e-1e1d-4c24-a2b3-dc1efbd18247.jpeg\",\"title\":\"Whats App Image 2026 10 21 at 09.08.28\",\"description\":null,\"type\":\"image/webp\",\"width\":1728,\"height\":2160}},\"activeFrom\":\"2026-10-20T15:01:00Z\",\"activeTo\":null,\"viewsCount\":177,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false},{\"id\":42,\"name\":\"Volleyball – international\",\"isNational\":false}]},{\"id\":1833,\"author\":\"SL\",\"title\":\"AVL Women: Hit in Linz an Sokol/Post, Men: Ried mit klarem, Klagenfurt mit hartem Auftaktsieg - \\\"Hartberg-Doppel\\\" im ORF\",\"perex\":\"Die UNIONvolleys Bisamberg-Hollabrunn haben sich in der Austrian Volley League Women nach der 0:3-Niederlage gegen die ATSC Kelag Wildcats Klagenfurt am Samstag mit einem Heimsieg zurückgemeldet. Die Niederösterreicherinnen setzten sich am Sonntag gegen Liganeuling SU Inzingvolley/VC Mils nach hartem Fight mit 3:1 (32:30, 29:31, 25:17, 25:11) durch.\",\"image\":\"6c8d97e0-903c-4e0b-9036-5b5d5b0d31f8\",\"imageEntity\":{\"id\":\"15f74416-d717-4e8b-ac33-67bce0ee270f\",\"url\":\"https://cdn.volley.eliterro.at/15f74416-d717-4e8b-ac33-67bce0ee270f.webp\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":null,\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"thumbnailEntity\":{\"id\":\"6c8d97e0-903c-4e0b-9036-5b5d5b0d31f8\",\"url\":\"https://cdn.volley.eliterro.at/6c8d97e0-903c-4e0b-9036-5b5d5b0d31f8.webp\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"15f74416-d717-4e8b-ac33-67bce0ee270f\",\"url\":\"https://cdn.volley.eliterro.at/15f74416-d717-4e8b-ac33-67bce0ee270f.webp\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":null,\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"preview\":{\"id\":\"6c8d97e0-903c-4e0b-9036-5b5d5b0d31f8\",\"url\":\"https://cdn.volley.eliterro.at/6c8d97e0-903c-4e0b-9036-5b5d5b0d31f8.webp\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"c9407b69-904e-4fd7-8d1b-2a161f3ac3a8\",\"url\":\"https://cdn.volley.eliterro.at/c9407b69-904e-4fd7-8d1b-2a161f3ac3a8.jpg\",\"title\":\"Gepa 20261018 101 147 1027\",\"description\":null,\"type\":\"image/webp\",\"width\":3240,\"height\":2160}},\"activeFrom\":\"2026-10-18T14:47:13Z\",\"activeTo\":null,\"viewsCount\":541,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1832,\"author\":\"SL\",\"title\":\"Klemen/Holzinger in Alanya auf Rang vier\",\"perex\":\"Klemen/Holzinger belegten beim Futures im türkischen Alanya den vierten Platz!\",\"image\":\"4630d2ab-dd0a-4040-a7ce-c4894dad473f\",\"imageEntity\":{\"id\":\"ef549191-08e3-4abd-ada3-7ebd1ced6a58\",\"url\":\"https://cdn.volley.eliterro.at/ef549191-08e3-4abd-ada3-7ebd1ced6a58.webp\",\"title\":\"20260523 Pörtschach Masters Nepel 277 Img 8195 Beachvolleyball Ball Symbol Symbolbild\",\"description\":null,\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"thumbnailEntity\":{\"id\":\"4630d2ab-dd0a-4040-a7ce-c4894dad473f\",\"url\":\"https://cdn.volley.eliterro.at/4630d2ab-dd0a-4040-a7ce-c4894dad473f.webp\",\"title\":\"20260523 Pörtschach Masters Nepel 277 Img 8195 Beachvolleyball Ball Symbol Symbolbild\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"ef549191-08e3-4abd-ada3-7ebd1ced6a58\",\"url\":\"https://cdn.volley.eliterro.at/ef549191-08e3-4abd-ada3-7ebd1ced6a58.webp\",\"title\":\"20260523 Pörtschach Masters Nepel 277 Img 8195 Beachvolleyball Ball Symbol Symbolbild\",\"description\":null,\"type\":\"image/webp\",\"width\":1620,\"height\":1080},\"preview\":{\"id\":\"4630d2ab-dd0a-4040-a7ce-c4894dad473f\",\"url\":\"https://cdn.volley.eliterro.at/4630d2ab-dd0a-4040-a7ce-c4894dad473f.webp\",\"title\":\"20260523 Pörtschach Masters Nepel 277 Img 8195 Beachvolleyball Ball Symbol Symbolbild\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"fdeafc28-7505-49a1-8e67-e53d8a4e68bf\",\"url\":\"https://cdn.volley.eliterro.at/fdeafc28-7505-49a1-8e67-e53d8a4e68bf.jpg\",\"title\":\"20260523 Pörtschach Masters Nepel 277 Img 8195 Beachvolleyball Ball Symbol Symbolbild\",\"description\":\"Copyright: Gert Nepel\",\"type\":\"image/webp\",\"width\":2400,\"height\":1600}},\"activeFrom\":\"2026-10-18T13:37:22Z\",\"activeTo\":null,\"viewsCount\":181,\"categories\":[{\"id\":42,\"name\":\"Volleyball – international\",\"isNational\":false}]},{\"id\":1831,\"author\":\"SL/PM/RED\",\"title\":\"AVL: Wildcats feiern Auswärtssieg, Erzbergmadln gewinnen Derby, Herren-Opener an Waldviertel\",\"perex\":\"Die ATSC Kelag Wildcats Klagenfurt haben sich in der 3. Runde der Austrian Volley League Women auswärts bei den UNIONvolleys Bisamberg-Hollabrunn in 69 Minuten klar mit 3:0 (25:10, 25:10, 25:23) durchgesetzt, damit ihren 2. Saisonerfolg eingefahren. Bei den Männern hat die Union Raiffeisen Waldviertel das Eröffnungsspiel der Austrian Volley League Men für sich entschieden. Die Nordmänner behielten bei der SPORTUNION z+p St. Pölten mit 3:1 (25:19, 21:25, 25:19, 25:20) die Oberhand. \",\"image\":\"929c217c-3cf1-4422-a8d1-960867d70711\",\"imageEntity\":{\"id\":\"b1ad74f4-5062-4a0f-aa45-b2b154be4811\",\"url\":\"https://cdn.volley.eliterro.at/b1ad74f4-5062-4a0f-aa45-b2b154be4811.webp\",\"title\":\"Pk 26 027\",\"description\":null,\"type\":\"image/webp\",\"width\":1619,\"height\":1080},\"thumbnailEntity\":{\"id\":\"929c217c-3cf1-4422-a8d1-960867d70711\",\"url\":\"https://cdn.volley.eliterro.at/929c217c-3cf1-4422-a8d1-960867d70711.webp\",\"title\":\"Pk 26 027\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"b1ad74f4-5062-4a0f-aa45-b2b154be4811\",\"url\":\"https://cdn.volley.eliterro.at/b1ad74f4-5062-4a0f-aa45-b2b154be4811.webp\",\"title\":\"Pk 26 027\",\"description\":null,\"type\":\"image/webp\",\"width\":1619,\"height\":1080},\"preview\":{\"id\":\"929c217c-3cf1-4422-a8d1-960867d70711\",\"url\":\"https://cdn.volley.eliterro.at/929c217c-3cf1-4422-a8d1-960867d70711.webp\",\"title\":\"Pk 26 027\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"9ba7af1d-12d7-483e-947f-5155a9bbd591\",\"url\":\"https://cdn.volley.eliterro.at/9ba7af1d-12d7-483e-947f-5155a9bbd591.jpg\",\"title\":\"Pk 26 027\",\"description\":null,\"type\":\"image/webp\",\"width\":3238,\"height\":2160}},\"activeFrom\":\"2026-10-17T16:07:04Z\",\"activeTo\":null,\"viewsCount\":440,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1830,\"author\":\"Sportlive\",\"title\":\"Linz entthront Sokol/Post im Supercup\",\"perex\":\"Im Prestigeduell zwischen den beiden dominierenden Teams der vergangenen Saison setzten sich die LINZ AG Steelvolleys in Graz mit einem 3:1 über die Titelverteidigerinnen von VB NÖ Sokol/Post zum zweiten Mal nach 2022 die Supercup-Krone auf.\",\"image\":\"fa5f812c-6734-4599-b0b2-17258a977fd2\",\"imageEntity\":{\"id\":\"fd8dae08-1fd1-4352-8b66-14bb554bacec\",\"url\":\"https://cdn.volley.eliterro.at/fd8dae08-1fd1-4352-8b66-14bb554bacec.webp\",\"title\":\"Gepa 20261016 101 157 1138\",\"description\":null,\"type\":\"image/webp\",\"width\":1619,\"height\":1080},\"thumbnailEntity\":{\"id\":\"fa5f812c-6734-4599-b0b2-17258a977fd2\",\"url\":\"https://cdn.volley.eliterro.at/fa5f812c-6734-4599-b0b2-17258a977fd2.webp\",\"title\":\"Gepa 20261016 101 157 1138\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"fd8dae08-1fd1-4352-8b66-14bb554bacec\",\"url\":\"https://cdn.volley.eliterro.at/fd8dae08-1fd1-4352-8b66-14bb554bacec.webp\",\"title\":\"Gepa 20261016 101 157 1138\",\"description\":null,\"type\":\"image/webp\",\"width\":1619,\"height\":1080},\"preview\":{\"id\":\"fa5f812c-6734-4599-b0b2-17258a977fd2\",\"url\":\"https://cdn.volley.eliterro.at/fa5f812c-6734-4599-b0b2-17258a977fd2.webp\",\"title\":\"Gepa 20261016 101 157 1138\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"7cc8f9d2-14d1-4829-b943-0b9178fb222b\",\"url\":\"https://cdn.volley.eliterro.at/7cc8f9d2-14d1-4829-b943-0b9178fb222b.JPG\",\"title\":\"Gepa 20261016 101 157 1138\",\"description\":\"Foto: GEPA pictures/ James Doak\",\"type\":\"image/webp\",\"width\":3238,\"height\":2160}},\"activeFrom\":\"2026-10-16T20:33:00Z\",\"activeTo\":null,\"viewsCount\":345,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1828,\"author\":\"Sportlive\",\"title\":\"Hartberg holt erneut den Supercup\",\"perex\":\"Der Supercupsieger 2026 heißt wie im Vorjahr TSV Raiffeisen Hartberg. Im steirischen Derby um den ersten Titel der Saison bezwang der Meister den Finals-Veranstalter und amtierenden Pokalgewinner UVC Holding Graz mit 3:0.\",\"image\":\"f1de4c56-78ce-421c-8a3e-ac3452f9807b\",\"imageEntity\":{\"id\":\"f563dbc4-5d38-472f-a329-7b166ded9dac\",\"url\":\"https://cdn.volley.eliterro.at/f563dbc4-5d38-472f-a329-7b166ded9dac.webp\",\"title\":\"Gepa 20261016 101 157 0131\",\"description\":null,\"type\":\"image/webp\",\"width\":1619,\"height\":1080},\"thumbnailEntity\":{\"id\":\"f1de4c56-78ce-421c-8a3e-ac3452f9807b\",\"url\":\"https://cdn.volley.eliterro.at/f1de4c56-78ce-421c-8a3e-ac3452f9807b.webp\",\"title\":\"Gepa 20261016 101 157 0131\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"media\":{\"full\":{\"id\":\"f563dbc4-5d38-472f-a329-7b166ded9dac\",\"url\":\"https://cdn.volley.eliterro.at/f563dbc4-5d38-472f-a329-7b166ded9dac.webp\",\"title\":\"Gepa 20261016 101 157 0131\",\"description\":null,\"type\":\"image/webp\",\"width\":1619,\"height\":1080},\"preview\":{\"id\":\"f1de4c56-78ce-421c-8a3e-ac3452f9807b\",\"url\":\"https://cdn.volley.eliterro.at/f1de4c56-78ce-421c-8a3e-ac3452f9807b.webp\",\"title\":\"Gepa 20261016 101 157 0131\",\"description\":null,\"type\":\"image/webp\",\"width\":720,\"height\":480},\"original\":{\"id\":\"ee513536-28b2-4502-b682-c0b151161314\",\"url\":\"https://cdn.volley.eliterro.at/ee513536-28b2-4502-b682-c0b151161314.JPG\",\"title\":\"Gepa 20261016 101 157 0131\",\"description\":\"Foto: GEPA pictures/ James Doak\",\"type\":\"image/webp\",\"width\":3238,\"height\":2160}},\"activeFrom\":\"2026-10-16T17:10:55Z\",\"activeTo\":null,\"viewsCount\":378,\"categories\":[{\"id\":41,\"name\":\"Volleyball – national\",\"isNational\":false}]},{\"id\":1827,\"author\":\"SL\",\"title\":\"FIVB Beach Pro Tour Future in Alanya\",\"perex\":\"Beim FIVB Beach Pro Tour Future in Alanya sind mehrere österreichische Teams im Einsatz.\",\"image\":\"92f6382c-b247-4f5b-9f77-7a6bf16d2be5\",\"imageEntity\":{\"id\":\"eecf4c89-fd18-469d-ae79-e015a070ed17\",\"url\":\"https://cdn.volley.eliterro.at/eecf4c89-fd18-469d-ae79-e015a070ed17.webp\",\"title\":\"Img 20260916 W A0000 (2)\",\"description\":null,\"type\":\"image/webp\",\"width\":920,\"height\":1080},\"thumbnailEntity\":{\"id\":\"92f6382c-b247-4f5b-9f77-7a6bf16d2be5\",\"url\":\"https://cdn.volley.eliterro.at/92f6382c-b247-4f5b-9f77-7a6bf16d2be5.webp\",\"title\":\"Img 20260916 W A0000 (2)\",\"description\":null,\"type\":\"image/webp\",\"width\":409,\"height\":480},\"media\":{\"full\":{\"id\":\"eecf4c89-fd18-469d-ae79-e015a070ed17\",\"url\":\"https://cdn.volley.eliterro.at/eecf4c89-fd18-469d-ae79-e015a070ed17.webp\",\"title\":\"Img 20260916 W A0000 (2)\",\"description\":null,\"type\":\"image/webp\",\"width\":920,\"height\":1080},\"preview\"